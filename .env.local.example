NEXT_PUBLIC_SITE_URL=https://bellostas.studio
NEXT_PUBLIC_SPLINE_SCENE_URL=

# Cal.com booking link — formato: {username}/{event-slug}
NEXT_PUBLIC_CAL_LINK=bellostas/30min
# Cal.com embed namespace (debe coincidir con el slug del event type)
NEXT_PUBLIC_CAL_NAMESPACE=30min
# Cal.com instance origin. Default cal.eu (EU GDPR). Si tu cuenta está en US: https://cal.com
NEXT_PUBLIC_CAL_ORIGIN=https://cal.eu

# ─── CRM Integration ────────────────────────────────────────────────────────
# Base URL del CRM (Bellostas Admin). En prod: https://admin.bellostas.studio
CRM_BASE_URL=https://admin.bellostas.studio
# Secret compartido para autenticar webhooks web → CRM.
# Generar con: openssl rand -hex 32
# IMPORTANT: NO usar prefijo NEXT_PUBLIC_ — el secret nunca debe llegar al cliente.
WEB_WEBHOOK_SECRET=

# Google Analytics 4 — se carga solo tras aceptar cookies analíticas (RGPD).
# Es un ID público (no secreto). Es NEXT_PUBLIC_, así que se hornea en el BUILD:
# configúralo en Dokploy ANTES de desplegar.
NEXT_PUBLIC_GA4_ID=G-2800YSB83Q

# (Opcional) Base URL para los vídeos de testimonios. Sin definir → se sirven
# desde /public/testimonials (lo normal para pocos vídeos). Si algún día mueves
# los .mp4 a Cloudflare R2 / CDN, pon aquí el dominio (sin barra final):
# NEXT_PUBLIC_VIDEO_BASE_URL=https://media.bellostas.studio

# ─── Payload CMS ────────────────────────────────────────────────────────────
# Postgres connection. Local dev: usa docker-compose.dev.yml (npm run db:up).
#   Local:  postgres://bellostas:bellostas_dev@localhost:5433/bellostas_web
#   Prod:   postgres://USER:PASS@<servicio-postgres-dokploy>:5432/bellostas_web
DATABASE_URI=postgres://bellostas:bellostas_dev@localhost:5433/bellostas_web

# Secret para firmar sesiones/JWT del admin. Generar con: openssl rand -hex 32
# NO usar prefijo NEXT_PUBLIC_.
PAYLOAD_SECRET=

# En PRODUCCIÓN, pon "true" para que Payload cree/sincronice el esquema en el
# arranque (sin archivos de migración). Déjalo sin definir en local (en dev el
# push está activo por defecto).
# PAYLOAD_DB_PUSH=true
